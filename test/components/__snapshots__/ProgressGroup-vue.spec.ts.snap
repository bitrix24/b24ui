    <li data-slot="item" class="flex items-center gap-1.5 min-w-0"><span data-slot="itemLeadingDot" class="shrink-0 rounded-(--ui-border-radius-pill) style-filled bg-(--b24ui-background) size-2"></span><span data-slot="itemLabel" class="truncate text-label">Apps</span><span data-slot="itemTrailing" class="ms-auto shrink-0 text-legend">100% </span></li>
  </ul>
</div>"
`;

