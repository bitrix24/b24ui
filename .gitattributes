# `skills/index.json` is generated by `pnpm run skill:sync`, and
# `test/utils/skill-manifest.spec.ts` compares the checked-out file to the
# generator's output byte for byte. The generator always emits `\n`, so a
# checkout that rewrote the file to CRLF — which `core.autocrlf=true` does by
# default on Windows — would fail that check locally against a file that is
# not actually stale.
skills/index.json text eol=lf
